# ============================================================
# Modelo de configuracao. Copie para .env.local e preencha.
#   cp .env.example .env.local
# O .env.local NUNCA e versionado.
# ============================================================

# --- Banco de dados -----------------------------------------
# Usuario dedicado da aplicacao, com permissao apenas neste banco.
# Nunca use o superusuario "postgres" aqui.
DATABASE_URL="postgresql://chamados_app:TROQUE_AQUI@127.0.0.1:5433/chamados?schema=public"

# --- Sessao -------------------------------------------------
# 32 bytes aleatorios em base64. Gere um novo por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor invalida todas as sessoes ativas.
SESSION_SECRET="TROQUE_AQUI"

# Duracao da sessao em horas (padrao: um turno de trabalho).
SESSION_TTL_HOURS=8

# Exigir HTTPS no cookie de sessao.
# Marque "true" APENAS se o portal for servido por HTTPS. Com "true" em um
# site HTTP, o navegador aceita o cookie mas nunca o reenvia, e o login entra
# em loop infinito de volta para a tela de entrada.
SESSION_COOKIE_SECURE=false

# --- Anexos -------------------------------------------------
# Diretorio de armazenamento. DEVE ficar fora de public/:
# nao pode existir URL direta para nenhum anexo.
STORAGE_DIR="./storage/attachments"

# 10 MB por arquivo
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_TICKET=5

# --- Aplicacao ----------------------------------------------
APP_TIMEZONE="America/Sao_Paulo"
