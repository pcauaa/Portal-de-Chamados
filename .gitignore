# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# anexos enviados pelos usuarios - ficam fora de public/ e nunca sao versionados
/storage

# dumps do banco gerados pelo backup diario - nunca versionar (contem dados reais)
/backups

# logs do servico (NSSM) e da aplicacao
/logs

# capturas de tela geradas por capturar-telas.ts
/telas

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ------------------------------------------------------------------
# Reforco: nada abaixo pode chegar a um repositorio publico.
# ------------------------------------------------------------------

# arquivos compactados e dumps de banco
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.bak
*.backup
*.dump
*.sql.gz

# chaves e certificados
*.key
*.pfx
*.p12
*.crt
*.cer
*.jks

# bancos locais
*.db
*.sqlite
*.sqlite3

# ferramentas de agente / IDE
/.agents
/.claude
/.windsurf
/.idea
/.vscode
skills-lock.json
